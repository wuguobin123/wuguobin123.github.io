    { "id": "call", "lane": "agent", "col": 2, "type": "backend", "label": "选择工具", "sublabel": "schema + scope" },
    { "id": "approve", "lane": "human", "col": 3, "type": "security", "label": "需要批准？", "sublabel": "副作用动作", "tag": "gate" },
    { "id": "run", "lane": "system", "col": 4, "type": "backend", "label": "执行与记录", "sublabel": "Host + events" },
